# ─────────────────────────────────────────────────────────────
# AI Tools — backend configuration
#
#   cp .env.example .env   then fill in the real values.
#   .env is git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5002
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────
# Production (Railway): MONGODB_URI=${{MongoDB.MONGO_URL}}  → mongodb.railway.internal
# Local against prod data: use MongoDB's MONGO_PUBLIC_URL (TCP proxy), e.g.
#   mongodb://mongo:<password>@viaduct.proxy.rlwy.net:<port>/aitools
# Local empty DB: mongodb://localhost:27017/aitools
# Atlas: mongodb+srv://…
#
# If local points at Atlas while Railway uses its Mongo plugin, agent workflows
# you create in production will NOT appear locally — they are different databases.
MONGODB_URI=

# ─── Redis ───────────────────────────────────────────────────
# Production: REDIS_URL=${{Redis.REDIS_URL}} → redis.railway.internal (required).
# Local: leave blank → in-process Memory fallback (cache/rate-limit/queue).
# That is WHY you see "using Memory" when running the backend on your laptop —
# REDIS_URL is unset. Railway Redis often has a broken REDIS_PUBLIC_URL (no host);
# enable a TCP proxy on the Redis service in Railway if you need local → Redis.
# Or run: docker run -p 6379:6379 redis:8  and set REDIS_URL=redis://127.0.0.1:6379
#
# BullMQ agent runs/builds use the same REDIS_URL. Without it: in-process queue.
REDIS_URL=

# ─── Auth ────────────────────────────────────────────────────
# Must be at least 32 characters in production (the server refuses to
# boot otherwise). Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Production must include the live frontend URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://aitools-frontned-production.up.railway.app

# ─── AI provider ─────────────────────────────────────────────
# Any OpenAI-compatible endpoint. The base URL must include the version
# path, because the client appends only /chat/completions.
#
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Together    https://api.together.xyz/v1
#
# Leave AI_BASE_URL blank to default to Groq.
AI_BASE_URL=
AI_API_KEY=

# Model routing — three tiers, split by what breaks when the model is wrong.
#
#   FAST       routing and classification. A wrong answer costs one bad
#              retrieval, so the cheapest model that can read is right.
#   PLANNER    chat and advisory workflows. Read by a person who can tell.
#   REASONING  the architect and the agent node. These write programs that then
#              run unattended against real APIs with the user's credentials, so
#              a confident wrong answer is a workflow quietly posting the wrong
#              thing every morning. Give this tier the strongest model you have;
#              it is metered by tokens, so it costs what it uses.
#
# FALLBACKS are tried in order when a primary errors, rate-limits or 404s.
# REASONING deliberately does not fall back — silently degrading a build to a
# small model produces exactly the invented-endpoint graphs this avoids.
#
# Verify your choices actually serve traffic with:  npm run check:providers
AI_MODEL_PLANNER=anthropic/claude-sonnet-4.6
AI_MODEL_FAST=deepseek/deepseek-v4-pro
AI_MODEL_REASONING=anthropic/claude-opus-4.8
AI_MODEL_FALLBACKS=openai/gpt-5-mini,openai/gpt-5.6-luna

# Model ids as OpenRouter actually names them today — verify with
# `curl https://openrouter.ai/api/v1/models` before changing any of these,
# since a slug that's one character off (a hyphen where OpenRouter uses a
# dot, e.g.) 404s outright rather than falling back. Priced in
# src/billing/pricing.js so margin reporting stays accurate:
#   anthropic/claude-opus-4.8   strongest; best at multi-step API research
#   anthropic/claude-sonnet-4.6 ~5x cheaper, close on structured tool use
#   deepseek/deepseek-v4-pro    cheapest of the three; slower, very long context

AI_TEMPERATURE=0.35

# Ceiling on a single chat completion. A guard against a runaway, not a cost
# control — cost control is the credit charge.
AI_MAX_TOKENS=4096

# The ceiling for agentic work (architect, agent node). Much larger, because
# truncating an architect turn mid-tool-call produces a malformed graph edit
# rather than a shorter one — billed once for the tokens and again for the
# rebuild. Set to 0 to send no ceiling and use the model's full output window.
AI_AGENTIC_MAX_TOKENS=32000

AI_TIMEOUT_MS=45000
# Frontier models reasoning over a rendered docs page routinely exceed 45s
# before the first token.
AI_AGENTIC_TIMEOUT_MS=180000
AI_MAX_RETRIES=2

# ─── Retrieval & workflow shape ──────────────────────────────
AI_RETRIEVAL_CANDIDATES=32
AI_MIN_STAGES=3
AI_MAX_STAGES=6

# ─── Caching & memory ────────────────────────────────────────
AI_CACHE_TTL_MS=1800000
AI_CACHE_MAX=500
AI_MEMORY_TURNS=8
AI_MEMORY_TTL_DAYS=30

# ─── Rate limiting (per user, per window) ────────────────────
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# ─── Vector search (Qdrant) ───────────────────────────────────
# Optional — same "absent config = feature cleanly disabled" pattern as
# everything else here. Powers the dense-retrieval leg (ai/retriever.js) and
# cross-session semantic memory recall (ai/memory.js).
#
# Railway: add the Qdrant template as service "vectordb" in the same project.
# ALWAYS use private networking — public *.up.railway.app URLs bill egress on
# every search/sync (same rule as Mongo/Redis private URLs).
#
#   QDRANT_URL=http://${{vectordb.RAILWAY_PRIVATE_DOMAIN}}:6333
#
# Optional overrides (local dev or if you split public/private explicitly):
#   QDRANT_PRIVATE_URL=http://localhost:6333
#   QDRANT_PRIVATE_DOMAIN=qdrant.railway.internal
#
# QDRANT_API_KEY only needed when auth is enabled on the Qdrant instance:
#   QDRANT_API_KEY=${{vectordb.QDRANT__SERVICE__API_KEY}}
QDRANT_URL=
QDRANT_API_KEY=
# Google AI Studio key — powers gemini-embedding-001 (free tier). No local ONNX.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
# Must match outputDimensionality (768 is the recommended truncated size).
EMBEDDING_DIMENSIONS=768

# ─── Web search (Tavily) ──────────────────────────────────────
# Optional. Powers the bounded, opt-in web-search tool (ai/tools/webSearch.js)
# used only when a user turns on "include tools beyond our catalog" and the
# question needs fresh/external info. Free tier: 1,000 credits/month.
TAVILY_API_KEY=
# Leaves headroom under the free-tier cap rather than running it to zero.
TAVILY_MONTHLY_CREDIT_CAP=900
WEB_SEARCH_CACHE_TTL_MS=21600000

# ─── Google Calendar / Gmail ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://aitools-backend-production.up.railway.app/api/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5002/api/integrations/google/callback
# Separate from JWT_SECRET. Generate: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# ─── Transactional email (Resend) ─────────────────────────────
# Used by core.email in agentic workflows and task reminders.
# Until you verify a custom domain in Resend, use their onboarding sender:
#   EMAIL_FROM=AI Tools <beth.t@example.com>
# After verifying your domain: AI Tools <noreply@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=AI Tools <beth.t@example.com>

# ─── Internal / n8n due-boards webhook ────────────────────────
# Protects POST /api/internal/reminders/run and due-boards. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=

# ─── Agentic workflows ────────────────────────────────────────
# Executable workflows: the node canvas and browser agents. Pro and above —
# see billing/plans.js. Everything except the browser half runs in-process, so
# this whole block is optional; unset values disable capability cleanly rather
# than failing a run halfway through.

# Master switch. Turn off to stop accepting runs without removing the UI.
AGENTIC_ENABLED=true

# --- Browser service ---
# Browser nodes need a remote Chrome. Two options — pick one:
#
# **Browserbase (recommended)** — hosted API, pay per session-minute, live view
# and session replay. No always-on Railway container. Get keys at browserbase.com.
#
#   BROWSERBASE_API_KEY=
#   BROWSERBASE_PROJECT_ID=
#   BROWSERBASE_REGION=us-west-2
#   AGENT_BROWSER_PROVIDER=browserbase
#
# **Self-hosted CDP** — Browserless/Steel on Railway as a PRIVATE service:
#
#   AGENT_BROWSER_WS=ws://browserless.railway.internal:3000?token=${{Browserless.TOKEN}}
#   AGENT_BROWSER_PROVIDER=cdp
#
# Leave all blank to disable browser nodes (the flow palette still works).
AGENT_BROWSER_PROVIDER=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=us-west-2
BROWSERBASE_BLOCK_ADS=true
BROWSERBASE_STEALTH=false
AGENT_BROWSER_WS=

# Only for images that mint a session over REST before handing out a socket
# (Steel). Leave blank to connect straight to AGENT_BROWSER_WS.
AGENT_BROWSER_API_URL=
AGENT_BROWSER_TOKEN=

# Ceilings. maxSession closes a hung page even if the runner itself is wedged —
# a browser that never closes bills wall-clock forever.
AGENT_BROWSER_MAX_SESSION_MS=300000
AGENT_BROWSER_TIMEOUT_MS=30000
AGENT_BROWSER_WIDTH=1280
AGENT_BROWSER_HEIGHT=800

# --- Run limits ---
AGENT_MAX_RUN_MS=600000
AGENT_MAX_NODES=60
# Bytes of one node's output kept on the run document. Past this it is
# truncated: blowing Mongo's 16MB limit mid-run loses the whole history.
AGENT_MAX_OUTPUT_BYTES=24000
# Runs a single worker process handles at once. Each browser run holds memory
# for Playwright + screenshots — size this against RAM (1–2 on small instances).
AGENT_WORKER_CONCURRENCY=2

# Ceiling on one node. The run ceiling alone is not a budget: an endpoint that
# accepts the connection and never answers eats all ten minutes, and the steps
# that would have worked never run. Nodes that are legitimately slow (Wait, AI
# Agent, AI Step) override this in the registry.
AGENT_NODE_TIMEOUT_MS=120000
# Shorter still for a plain HTTP call, which has no reason to think.
AGENT_HTTP_TIMEOUT_MS=30000
# Attempts per node, including the first. Only failures that left the far end
# unchanged are retried — a dropped connection on an email node is not, since
# the message may already have gone. See src/agentic/retry.js.
AGENT_NODE_ATTEMPTS=3

# --- Egress guard ---
# Workflow URLs are user- and model-authored, and we fetch them with our own
# network position. These block the classic SSRF targets.
AGENT_BLOCKED_HOSTS=169.254.169.254,metadata.google.internal,localhost,127.0.0.1,::1
# Defaults to true in development, false in production. Never enable in prod:
# it is what stands between a workflow and mongo.railway.internal.
AGENT_ALLOW_PRIVATE_NETWORK=

# --- Cost accounting ---
# Amortised cost of a browser session-minute, in paise. Our infra cost divided
# by the session-minutes it can serve — not a published price. Feeds
# UsageLedger so agentic margin is measured like every other action.
BILLING_BROWSER_PAISE_PER_MINUTE=10
