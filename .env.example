# ─────────────────────────────────────────────────────────────
# AI Tools — backend configuration
#
#   cp .env.example .env   then fill in the real values.
#   .env is git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5002
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/aitools
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/<db>
# Railway MongoDB plugin injects MONGO_URL — also accepted if MONGODB_URI is unset.
# Railway Variables:  MONGODB_URI=${{MongoDB.MONGO_URL}}
MONGODB_URI=

# ─── Auth ────────────────────────────────────────────────────
# Must be at least 32 characters in production (the server refuses to
# boot otherwise). Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── AI provider ─────────────────────────────────────────────
# Any OpenAI-compatible endpoint. The base URL must include the version
# path, because the client appends only /chat/completions.
#
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Together    https://api.together.xyz/v1
#
# Leave AI_BASE_URL blank to default to Groq.
AI_BASE_URL=
AI_API_KEY=

# Model routing. PLANNER does the reasoning-heavy work (plans, playbooks);
# FAST handles routing and classification. FALLBACKS are tried in order
# when the primary model errors, rate-limits or 404s.
# Recommended via OpenRouter: planner=openai/gpt-5.6-luna, fast=openai/gpt-5-mini
# Verify your choices actually serve traffic with:  npm run check:providers
AI_MODEL_PLANNER=openai/gpt-5.6-luna
AI_MODEL_FAST=openai/gpt-5-mini
AI_MODEL_FALLBACKS=openai/gpt-5-mini,openai/gpt-5.6-luna

AI_TEMPERATURE=0.35
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# ─── Retrieval & workflow shape ──────────────────────────────
AI_RETRIEVAL_CANDIDATES=32
AI_MIN_STAGES=3
AI_MAX_STAGES=6

# ─── Caching & memory ────────────────────────────────────────
AI_CACHE_TTL_MS=1800000
AI_CACHE_MAX=500
AI_MEMORY_TURNS=8
AI_MEMORY_TTL_DAYS=30

# ─── Rate limiting (per user, per window) ────────────────────
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# ─── Redis ───────────────────────────────────────────────────
# Backs the AI cache, telemetry counters and the rate limiter. Required in
# production (Railway: add the "Redis" template to the project — it injects
# this automatically) so state is shared across instances and survives a
# redeploy. Safe to leave blank for local dev: falls back to an in-process
# store automatically, just without cross-instance/restart durability.
REDIS_URL=

# ─── Vector search (Qdrant) ───────────────────────────────────
# Optional — same "absent config = feature cleanly disabled" pattern as
# everything else here. Powers the dense-retrieval leg (ai/retriever.js) and
# cross-session semantic memory recall (ai/memory.js). Railway: add the
# "Qdrant" template. QDRANT_API_KEY only needed if you've set one on the
# Qdrant instance itself.
QDRANT_URL=
QDRANT_API_KEY=
# Must match the embedding model's actual output size (384 for the default).
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# ─── Web search (Tavily) ──────────────────────────────────────
# Optional. Powers the bounded, opt-in web-search tool (ai/tools/webSearch.js)
# used only when a user turns on "include tools beyond our catalog" and the
# question needs fresh/external info. Free tier: 1,000 credits/month.
TAVILY_API_KEY=
# Leaves headroom under the free-tier cap rather than running it to zero.
TAVILY_MONTHLY_CREDIT_CAP=900
WEB_SEARCH_CACHE_TTL_MS=21600000

# ─── Google Calendar / Gmail ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5002/api/integrations/google/callback
INTEGRATION_ENCRYPTION_KEY=

# ─── Transactional email (Resend) ─────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=AI Tools <noreply@example.com>

# ─── Internal / n8n due-boards webhook ────────────────────────
INTERNAL_API_SECRET=
